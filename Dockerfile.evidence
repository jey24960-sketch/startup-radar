FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_THREAD_LIMIT=1
WORKDIR /app
COPY requirements-v2.lock.txt requirements-ocr.lock.txt ./
RUN pip install --no-cache-dir -r requirements-v2.lock.txt -r requirements-ocr.lock.txt
COPY radar ./radar
COPY core ./core
COPY tools/prepare_ocr_models.py ./tools/prepare_ocr_models.py
RUN python -m tools.prepare_ocr_models /opt/tessdata && chmod 0444 /opt/tessdata/kor.traineddata /opt/tessdata/eng.traineddata
USER 65534:65534
